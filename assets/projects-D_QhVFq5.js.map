      "faq": {
        "free": {
          "question": "Ist FreeCut wirklich kostenlos?",
          "answer": "Ja, FreeCut ist vollständig kostenlos und Open Source unter der MIT-Lizenz. Es gibt keine versteckten Gebühren, Abonnements oder Wasserzeichen."
        },
        "install": {
          "question": "Muss ich etwas installieren?",
          "answer": "Keine Installation erforderlich. FreeCut läuft vollständig in deinem Browser. Öffne einfach die Website und beginne mit dem Bearbeiten."
        },
        "storage": {
          "question": "Wo werden meine Videos gespeichert?",
          "answer": "Deine Videos und Projekte werden lokal in deinem Browser gespeichert oder über moderne Speicher-APIs auf deine lokalen Dateien verwiesen."
        },
        "browsers": {
          "question": "Welche Browser werden unterstützt?",
          "answerP1": "FreeCut funktioniert derzeit am besten in Chrome oder Edge 113+. Es stützt sich auf moderne Browser-APIs wie WebGPU, WebCodecs, OPFS und File System Access, daher ist der vollständige Workflow derzeit Chromium-orientiert.",
          "answerP2": "<strong>Brave-Nutzer:</strong> Die File System Access API ist standardmäßig deaktiviert. Um sie zu aktivieren, gehe zu <code>brave://flags/#file-system-access-api</code>, stelle sie auf <strong>Enabled</strong> und starte den Browser neu."
        },
        "exportFormats": {
          "question": "Welche Exportformate werden unterstützt?",
          "answer": "Video: MP4, MOV, WebM, MKV. Audio: MP3, AAC, WAV (PCM). Die aktuelle Export-Oberfläche bietet H.264, H.265, VP8, VP9 und AV1 mit den Qualitätsvoreinstellungen niedrig, mittel, hoch und ultra."
        },
        "future": {
          "question": "Künftige Verbesserungen",
          "answer": "Der aktuelle Fokus liegt auf der Beta-Stabilisierung: die Produktdokumentation an das ausgelieferte Verhalten anpassen, Barrierefreiheit und Testabdeckung verbessern und Standardwerte wie FPS, Einrasten, Vorschauqualität und Exporteinstellungen durch den echten Editor laufen lassen."
        },
        "shoutout": {
          "question": "Besonderer Dank",
          "answerP1": "Ein riesiges Dankeschön an <link>Mediabunny</link>, dass es die browserbasierte Videocodierung einfach gemacht hat. Dieses Projekt würde ohne ihre großartige Arbeit nicht existieren!",
          "builtWith": "Erstellt mit:"
        }
      }
