      "faq": {
        "free": {
          "question": "O FreeCut é realmente gratuito?",
          "answer": "Sim, o FreeCut é totalmente gratuito e de código aberto sob a licença MIT. Não há taxas ocultas, assinaturas ou marcas d'água."
        },
        "install": {
          "question": "Preciso instalar alguma coisa?",
          "answer": "Nenhuma instalação necessária. O FreeCut funciona inteiramente no seu navegador. Basta abrir o site e começar a editar."
        },
        "storage": {
          "question": "Onde meus vídeos são armazenados?",
          "answer": "Seus vídeos e projetos são armazenados localmente no seu navegador ou referenciados aos seus arquivos locais usando APIs de armazenamento modernas."
        },
        "browsers": {
          "question": "Quais navegadores são compatíveis?",
          "answerP1": "O FreeCut funciona melhor no Chrome ou Edge 113+. Ele depende de APIs modernas do navegador como WebGPU, WebCodecs, OPFS e File System Access, então o fluxo completo é atualmente voltado para o Chromium.",
          "answerP2": "<strong>Usuários do Brave:</strong> a File System Access API está desativada por padrão. Para ativá-la, vá para <code>brave://flags/#file-system-access-api</code>, defina como <strong>Enabled</strong> e reinicie o navegador."
        },
        "exportFormats": {
          "question": "Quais formatos de exportação são compatíveis?",
          "answer": "Vídeo: MP4, MOV, WebM, MKV. Áudio: MP3, AAC, WAV (PCM). A interface de exportação atual oferece H.264, H.265, VP8, VP9 e AV1 com predefinições de qualidade baixa, média, alta e ultra."
        },
        "future": {
          "question": "Melhorias futuras",
          "answer": "O foco atual é o fortalecimento da beta: alinhar a documentação do produto com o comportamento entregue, reforçar a acessibilidade e a cobertura de testes, e fazer com que padrões como FPS, ajuste, qualidade da prévia e configurações de exportação fluam pelo editor real."
        },
        "shoutout": {
          "question": "Agradecimento especial",
