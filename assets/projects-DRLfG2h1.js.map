      "faq": {
        "free": {
          "question": "¿FreeCut es realmente gratis?",
          "answer": "Sí, FreeCut es completamente gratis y de código abierto bajo la licencia MIT. No hay tarifas ocultas, suscripciones ni marcas de agua."
        },
        "install": {
          "question": "¿Necesito instalar algo?",
          "answer": "No se requiere instalación. FreeCut funciona enteramente en tu navegador. Solo abre el sitio web y empieza a editar."
        },
        "storage": {
          "question": "¿Dónde se guardan mis videos?",
          "answer": "Tus videos y proyectos se guardan localmente en tu navegador o se referencian a tus archivos locales mediante APIs de almacenamiento modernas."
        },
        "browsers": {
          "question": "¿Qué navegadores son compatibles?",
          "answerP1": "FreeCut funciona mejor en Chrome o Edge 113+. Depende de APIs modernas del navegador como WebGPU, WebCodecs, OPFS y File System Access, por lo que el flujo completo es actualmente Chromium-first.",
          "answerP2": "<strong>Usuarios de Brave:</strong> la File System Access API está desactivada por defecto. Para activarla, ve a <code>brave://flags/#file-system-access-api</code>, ponla en <strong>Enabled</strong> y reinicia el navegador."
        },
        "exportFormats": {
          "question": "¿Qué formatos de exportación son compatibles?",
          "answer": "Video: MP4, MOV, WebM, MKV. Audio: MP3, AAC, WAV (PCM). La interfaz de exportación actual ofrece H.264, H.265, VP8, VP9 y AV1 con preajustes de calidad baja, media, alta y ultra."
        },
        "future": {
          "question": "Mejoras futuras",
          "answer": "El enfoque actual es endurecer la beta: alinear la documentación del producto con el comportamiento real, reforzar la accesibilidad y la cobertura de pruebas, y hacer que los valores por defecto como FPS, ajuste, calidad de vista previa y ajustes de exportación fluyan a través del editor real."
        },
